{% comment %}
  Local override of al-folio's news.liquid. Three changes from the theme version:

  1. Dates render as "%b %Y" (month + year). The source archive only ever gave
     month granularity, so a day number would be invented precision.
  2. News items may carry one or more images, floated beside the item text. Add
     to any file in _news/:

         images:
           - path: assets/img/news/2026/flight-school.jpg
             alt: Students walking the flight line at Bill Noe Flight School
             caption: K-12 field trip to the flight school

     Items without images render exactly as before.
  3. Thumbnails are served as responsive webp, but medium-zoom opens the
     untouched full-resolution jpg via data-zoom-src (it drops srcset/sizes on
     the zoomed clone, so the source file is what the reader actually gets).
{% endcomment %}

<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %Y' }}</th>
            <td>
              {% comment %} Floated first so the item text wraps alongside it. {% endcomment %}
              {% if item.images %}
                <div class="news-images">
                  {% for img in item.images %}
                    {% assign img_base = img.path | remove: '.jpg' | remove: '.jpeg' | remove: '.png' %}
                    <figure class="news-image">
                      <picture>
                        {% if site.imagemagick.enabled %}
                          <source
                            class="responsive-img-srcset"
                            srcset="{% for w in site.imagemagick.widths %}{{ img_base | relative_url }}-{{ w }}.webp {{ w }}w,{% endfor %}"
                            type="image/webp"
                            sizes="(max-width: 576px) 92vw, 220px"
                          >
                        {% endif %}
                        <img
                          src="{{ img.path | relative_url }}"
                          class="img-fluid rounded z-depth-1"
                          alt="{{ img.alt }}"
                          loading="lazy"
                          data-zoomable
                          data-zoom-src="{{ img.path | relative_url }}"
                          onerror="this.onerror=null; document.querySelectorAll('.responsive-img-srcset').forEach(function (n) { n.remove(); });"
                        >
                      </picture>
                      <figcaption class="caption news-image-caption">{{ img.caption }}</figcaption>
                    </figure>
                  {% endfor %}
                </div>
              {% endif %}
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>

<style>
  .news-images {
    float: right;
    width: 220px;
    margin: 0.15rem 0 0.5rem 1.25rem;
  }
  .news-image {
    margin: 0 0 0.9rem 0;
  }
  .news-image:last-child {
    margin-bottom: 0;
  }
  .news-image img {
    width: 100%;
    height: auto;
    cursor: zoom-in;
  }
  /* Tighter than the theme's .caption, which is sized for full-width figures. */
  .news-image-caption {
    font-size: 0.75rem;
    line-height: 1.35;
    margin-top: 0.35rem;
    margin-bottom: 0;
    text-align: left;
  }
  /* Keep a tall thumbnail from spilling into the next news row. */
  .news td::after {
    content: '';
    display: block;
    clear: both;
  }
  @media (max-width: 576px) {
    .news-images {
      float: none;
      width: 100%;
      margin: 0 0 0.75rem 0;
    }
    .news-image-caption {
      text-align: center;
    }
  }
</style>
