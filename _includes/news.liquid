{% comment %}
  Local override of al-folio's news.liquid. Two changes from the theme version:

  1. Dates render as "%b %Y" (month + year). The source archive only ever gave
     month granularity, so a day number would be invented precision.
  2. News items may carry an optional image. Add to any file in _news/:

         image: news/2026/flight-school.jpg   # path under assets/img/
         image_alt: Students touring the flight school
         image_width: 260                     # optional, px; defaults to 220

     Items without an image render exactly as before.
{% endcomment %}

<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
              {% if item.image %}
                <div class="news-image">
                  <img
                    src="{{ item.image | prepend: '/assets/img/' | relative_url }}"
                    alt="{{ item.image_alt | default: '' }}"
                    loading="lazy"
                    style="max-width: {{ item.image_width | default: 220 }}px">
                  {% if item.image_alt %}<div class="news-image-caption">{{ item.image_alt }}</div>{% endif %}
                </div>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>

<style>
  .news-image {
    margin-top: 0.5rem;
  }
  .news-image img {
    width: 100%;
    height: auto;
    border-radius: 6px;
    display: block;
  }
  .news-image-caption {
    font-size: 0.8rem;
    opacity: 0.7;
    margin-top: 0.25rem;
  }
</style>
